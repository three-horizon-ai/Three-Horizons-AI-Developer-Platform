# Three Horizons AI Platform - Sample Environment Configuration

# Azure Configuration
AZURE_SUBSCRIPTION_ID=${{ values.azure_subscription_id }}
AZURE_TENANT_ID=${{ values.azure_tenant_id }}
AZURE_RESOURCE_GROUP=${{ values.project_name }}-rg
AZURE_LOCATION=${{ values.azure_region }}

# Developer Configuration
DEVELOPER_NAME="${{ values.developer_name }}"
TEAM="${{ values.team }}"
PROJECT_NAME="${{ values.project_name }}"

# GitHub Configuration
GITHUB_ORG="${{ values.github_organization }}"
GITHUB_REPO="${{ values.project_name }}"

# Kubernetes Configuration
KUBERNETES_NAMESPACE="${{ values.project_name }}-dev"
KUBERNETES_CLUSTER_NAME="${{ values.project_name }}-aks"

# Application Configuration
APP_PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# Development Preferences
PREFERRED_SHELL="${{ values.preferred_shell }}"
EDITOR="code"

# Three Horizons Configuration
THREE_HORIZONS_ENV="devbox"
THREE_HORIZONS_VERSION="1.0.0"

# AI/ML Configuration (if enabled)
{% if 'azure_openai' in values.ai_tools %}
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4"
{% endif %}

# Database Configuration (if enabled)
{% if 'postgresql' in values.databases %}
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="${{ values.project_name }}_dev"
POSTGRES_USER="developer"
POSTGRES_PASSWORD="dev_password_change_me"
{% endif %}

{% if 'mongodb' in values.databases %}
MONGODB_URI="mongodb://localhost:27017/${{ values.project_name }}_dev"
{% endif %}

{% if 'redis' in values.databases %}
REDIS_URL="redis://localhost:6379"
{% endif %}
