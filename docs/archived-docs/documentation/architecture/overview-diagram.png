<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="900" height="560" version="1.1" viewBox="0 0 900 560">
    <!-- Background -->
    <rect width="900" height="560" fill="#fffef0" rx="10" ry="10"/>
    
    <!-- Title -->
    <text x="450" y="50" font-family="Arial, sans-serif" font-size="24" font-weight="bold" text-anchor="middle" fill="#333">Developer Experience Ecosystem</text>
    
    <!-- Technology Boxes -->
    <rect x="120" y="100" width="180" height="65" stroke="#0078d4" stroke-width="2" fill="#e6f2ff" rx="8" ry="8"/>
    <text x="210" y="130" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#0078d4">Microsoft Azure</text>
    <text x="210" y="152" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#333">Infrastructure &amp; Platform</text>
    
    <rect x="340" y="100" width="220" height="65" stroke="#cc0000" stroke-width="2" fill="#fff5f5" rx="8" ry="8"/>
    <text x="450" y="130" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#cc0000">Red Hat Developer Hub</text>
    <text x="450" y="152" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#333">Developer Portal</text>
    
    <rect x="600" y="100" width="180" height="65" stroke="#24292e" stroke-width="2" fill="#f0f0f0" rx="8" ry="8"/>
    <text x="690" y="130" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#24292e">GitHub Enterprise</text>
    <text x="690" y="152" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#333">DevOps &amp; Security</text>
    
    <!-- Three Horizons Platform Box -->
    <rect x="330" y="220" width="240" height="80" stroke="#662c91" stroke-width="3" fill="#f9f0ff" rx="10" ry="10"/>
    <text x="450" y="265" font-family="Arial, sans-serif" font-size="20" font-weight="bold" text-anchor="middle" fill="#662c91">Three Horizons Platform</text>
    
    <!-- Output Boxes -->
    <rect x="90" y="360" width="150" height="65" stroke="#333" stroke-width="2" fill="#e6f2ff" rx="8" ry="8"/>
    <text x="165" y="392" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Golden Paths</text>
    <text x="165" y="412" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#555">Delivers</text>
    
    <rect x="270" y="360" width="150" height="65" stroke="#333" stroke-width="2" fill="#e6f2ff" rx="8" ry="8"/>
    <text x="345" y="392" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">DevBox Templates</text>
    <text x="345" y="412" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#555">Provides</text>
    
    <rect x="450" y="360" width="150" height="65" stroke="#333" stroke-width="2" fill="#e6f2ff" rx="8" ry="8"/>
    <text x="525" y="392" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Inner Loop Dev</text>
    <text x="525" y="412" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#555">Enables</text>
    
    <rect x="630" y="360" width="200" height="65" stroke="#333" stroke-width="2" fill="#e6f2ff" rx="8" ry="8"/>
    <text x="730" y="392" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Outer Loop Deployment</text>
    <text x="730" y="412" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="#555">Streamlines</text>
    
    <!-- Connection Lines -->
    <line x1="210" y1="165" x2="350" y2="220" stroke="#0078d4" stroke-width="2"/>
    <line x1="450" y1="165" x2="450" y2="220" stroke="#cc0000" stroke-width="2"/>
    <line x1="690" y1="165" x2="550" y2="220" stroke="#24292e" stroke-width="2"/>
    
    <line x1="360" y1="300" x2="165" y2="360" stroke="#662c91" stroke-width="2"/>
    <line x1="400" y1="300" x2="345" y2="360" stroke="#662c91" stroke-width="2"/>
    <line x1="500" y1="300" x2="525" y2="360" stroke="#662c91" stroke-width="2"/>
    <line x1="540" y1="300" x2="730" y2="360" stroke="#662c91" stroke-width="2"/>
    
    <!-- Footer Caption -->
    <text x="450" y="490" font-family="Arial, sans-serif" font-size="14" font-style="italic" text-anchor="middle" fill="#555">
        Integrating Microsoft Azure, Red Hat Developer Hub, and GitHub Enterprise
    </text>
</svg> 