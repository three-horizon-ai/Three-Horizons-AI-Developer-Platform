digraph "Three Horizons Architecture" {
    graph [fontname="Arial", fontsize=14, compound=true, rankdir=TB, splines=ortho, nodesep=0.8, ranksep=1.0];
    node [fontname="Arial", fontsize=12, shape=box, style="rounded,filled", fillcolor=white, color="#4285F4", margin="0.2,0.1"];
    edge [fontname="Arial", fontsize=10, color="#4285F4"];

    // Platform components
    subgraph cluster_azure {
        label="Microsoft Azure";
        style="rounded,filled";
        color="#0078D4";
        fillcolor="#E6F2FB";
        
        subgraph cluster_aro {
            label="Azure Red Hat OpenShift";
            style="rounded,filled";
            color="#CC0000";
            fillcolor="#FFEBEE";
            
            aro_control [label="ARO Control Plane", fillcolor="#FFCDD2"];
            aro_data [label="ARO Data Plane", fillcolor="#FFCDD2"];
            aro_infra [label="ARO Infrastructure", fillcolor="#FFCDD2"];
            aro_control -> aro_data [dir=both];
            aro_control -> aro_infra [dir=both];
        }
        
        subgraph cluster_azure_services {
            label="Azure Services";
            style="rounded,filled";
            color="#0078D4";
            fillcolor="#E3F2FD";
            
            azure_ad [label="Azure Active Directory", fillcolor="#BBDEFB"];
            azure_monitor [label="Azure Monitor", fillcolor="#BBDEFB"];
            azure_keyvault [label="Azure Key Vault", fillcolor="#BBDEFB"];
            azure_acr [label="Azure Container Registry", fillcolor="#BBDEFB"];
        }
        
        azure_vnet [label="Azure Virtual Network", fillcolor="#D1C4E9"];
    }
    
    subgraph cluster_github {
        label="GitHub Enterprise";
        style="rounded,filled";
        color="#24292E";
        fillcolor="#F5F5F5";
        
        github_repos [label="Repositories", fillcolor="#E0E0E0"];
        github_actions [label="GitHub Actions", fillcolor="#E0E0E0"];
        github_copilot [label="GitHub Copilot", fillcolor="#E0E0E0"];
        github_apps [label="GitHub Apps", fillcolor="#E0E0E0"];
        
        github_repos -> github_actions;
        github_copilot -> github_repos [label="Assists"];
    }
    
    subgraph cluster_developer_hub {
        label="Red Hat Developer Hub";
        style="rounded,filled";
        color="#CC0000";
        fillcolor="#FFEBEE";
        
        dev_hub_portal [label="Developer Portal", fillcolor="#FFCDD2"];
        dev_hub_catalog [label="Service Catalog", fillcolor="#FFCDD2"];
        dev_hub_scaffolder [label="Scaffolder", fillcolor="#FFCDD2"];
        dev_hub_golden_paths [label="Golden Paths", fillcolor="#FFCDD2"];
        
        dev_hub_portal -> dev_hub_catalog;
        dev_hub_portal -> dev_hub_scaffolder;
        dev_hub_scaffolder -> dev_hub_golden_paths;
    }
    
    // Connections between components
    azure_ad -> dev_hub_portal [label="Authenticates"];
    github_repos -> dev_hub_catalog [label="Provides"];
    github_actions -> aro_control [label="Deploys to"];
    dev_hub_scaffolder -> github_repos [label="Creates"];
    azure_keyvault -> dev_hub_portal [label="Secures"];
    azure_monitor -> aro_control [label="Monitors"];
    azure_acr -> aro_data [label="Provides images"];
    github_apps -> dev_hub_portal [label="Integrates"];
    azure_vnet -> aro_control [label="Networks"];
    
    // Developer workflow
    developer [label="Developer", shape=actor, fillcolor="#C8E6C9"];
    developer -> dev_hub_portal [label="Uses"];
    developer -> github_repos [label="Codes in"];
    github_copilot -> developer [label="Assists"];
    
    // Operations workflow
    operator [label="Platform Operator", shape=actor, fillcolor="#C8E6C9"];
    operator -> azure_monitor [label="Monitors"];
    operator -> aro_control [label="Manages"];
    
    // Deployment flow
    deployment_flow [label="CI/CD Pipeline", shape=component, fillcolor="#D1C4E9"];
    github_actions -> deployment_flow;
    deployment_flow -> aro_data [label="Deploys to"];

    // Legend
    subgraph cluster_legend {
        label="Legend";
        style="rounded,filled";
        color="gray";
        fillcolor="white";
        
        legend_user [label="User", shape=actor, fillcolor="#C8E6C9"];
        legend_component [label="Component", shape=box, style="rounded,filled", fillcolor="white"];
        legend_cloud_component [label="Cloud Service", shape=box, style="rounded,filled", fillcolor="#BBDEFB"];
        legend_flow [label="Flow", shape=component, fillcolor="#D1C4E9"];
        
        legend_user -> legend_component [style=invis];
        legend_component -> legend_cloud_component [style=invis];
        legend_cloud_component -> legend_flow [style=invis];
    }
}
